{
  "manifest_version": 3,
  "name": "Wheel Rigger",
  "version": "1.0.0",
  "description": "Quietly decides who the wheel lands on at wheelofnames.com.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": [
    "*://wheelofnames.com/*",
    "*://*.wheelofnames.com/*"
  ],
  "background": {
    "service_worker": "src/sw.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Wheel Rigger",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://wheelofnames.com/*", "*://*.wheelofnames.com/*"],
      "js": ["src/main-world.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["*://wheelofnames.com/*", "*://*.wheelofnames.com/*"],
      "js": ["src/bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
